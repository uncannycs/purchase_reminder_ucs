<odoo>
    <record id="due_date_reminder_email_template" model="mail.template">
        <field name="name">Reminder of due date of purchase quotation</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="auto_delete" eval="False"/>
        <field name="email_from">{{ ctx.get('object').user_id.email }}</field>
        <field name="email_to">{{ ctx.get('object').user_id.email }}</field>
        <field name="subject">{{ctx.get('object').name}} is due on {{ctx.get('object').due_date}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-size: 13px;">
            Here Your Purchase Quotation
                <b>
                    <t t-out="ctx.get('object').name or ''"/>
                </b> from 
                <b>
                    <t t-out="ctx.get('object').company_id.name or ''"/>
                </b> have due date
                <b>
                    <t t-out="ctx.get('object').due_date or ''"/>
                </b>
                <br/>
                <br/>

                <div style="padding-left: 20px;">
                    <b>REFERENCES</b>
                    <br/>
                    RFQ number: <b>
                    <t t-out="ctx.get('object').name or ''"/>
                </b>
                <br/>
                RFQ date:
                <t t-out="ctx.get('today','')"/>

            </div>
            <br/>
            if you have any question, do not hesitate to contact us. <br/>
            Thank you!

        </div>

    </field>
</record>
</odoo>

